default partial alphanumeric_keys
xkb_symbols "basic" {

    include "us(basic)"

    replace key <AE02> { [ 2, quotedbl,  at ] };
    replace key <AE04> { [ 4, semicolon, dollar ] };
    replace key <AE06> { [ 6, colon,     asciicircum] };
    replace key <AE07> { [ 7, question,  ampersand ] };
    

    // replace key <AE06> { [ 6, colon ] };
    // replace key <AE07> { [ 7, question ] };
};
